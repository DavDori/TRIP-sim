<?xml version="1.0"?>
<robot name="trip" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <material name="light_black">
        <color rgba="0.4 0.4 0.4 1.0"/>
    </material>
    <material name="orange">
        <color rgba="1.0 0.4235 0.0392 1.0"/>
    </material>

    <!--  BASE LINK  -->
    <link name="${robot_name}/base_link">
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="5.0"/>
        <inertia
        ixx="0.05" ixy="0.0" ixz="0.0"
        iyy="0.05" iyz="0.0"
        izz="0.08"/>
    </inertial>

    <visual>
        <origin xyz="0.003 -0.002 -0.075" rpy="0 0 ${pi}"/>
        <geometry>
            <mesh filename="/home/davdori/trip_ws/src/TRIP-sim/trip_description/meshes/base_link.dae"/>
        </geometry>
        <material name="light_black"/>
    </visual>

    <collision>
        <origin xyz="-0.004 0 0" rpy="0 0 0"/>
        <geometry>
        <box size="0.16 0.103 0.11"/>
        </geometry>
    </collision>
    </link>
</robot>
