<?xml version="1.0"?>
<robot name="trip" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="mesh_path" value="$(env TRIP_PATH)/meshes"/>
  
  <material name="blue_custom">
      <color rgba="0.0 0.0 1.0 1.0"/>
  </material>

  <link name="${robot_name}/lidar_pitch_link">
    <visual>
        <origin xyz="-0.02 0.00 0.0" rpy="0 0 ${pi}"/>
        <geometry>
            <mesh filename="${mesh_path}/lidar_fixed_base.dae"/>
        </geometry>
        <material name="blue_custom"/>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0005" iyy="0.0005" izz="0.0005"
              ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <link name="${robot_name}/lidar_link">
    <visual>
        <origin xyz="0.00 0.00 0.00" rpy="0 0 ${pi}"/>
        <geometry>
            <mesh filename="${mesh_path}/lidar.dae"/>
        </geometry>
        <material name="blue_custom"/>
    </visual>
    <inertial>
      <mass value="0.01"/>
      <inertia
        ixx="1e-5" ixy="0.0" ixz="0.0"
        iyy="1e-5" iyz="0.0"
        izz="1e-5"/>
    </inertial>
  </link>

  <joint name="lidar_roll_joint" type="revolute">
    <parent link="${robot_name}/lidar_pitch_link"/>
    <child link="${robot_name}/lidar_link"/>
    <origin xyz="0.01 0 0.01" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.35" upper="0.35" effort="1.0" velocity="1.0"/>
  </joint>

  <joint name="lidar_mount_joint" type="fixed">
    <parent link="${robot_name}/base_link"/>
    <child link="${robot_name}/lidar_pitch_link"/>
    <origin xyz="0.04 0 0.07" rpy="0 0 0"/>
  </joint>

  <gazebo reference="${robot_name}/lidar_link">
    <sensor name="lidar_sensor" type="ray">
      <update_rate>10</update_rate>

      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.14</min_angle>
            <max_angle>3.14</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>

      <plugin name="trip_lidar_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/trip</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <frame_name>${robot_name}/lidar_link</frame_name>
        <output_type>sensor_msgs/LaserScan</output_type>
      </plugin>
    </sensor>
  </gazebo>

</robot>
