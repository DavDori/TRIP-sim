<?xml version="1.0"?>
<robot name="trip" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <link name="${robot_name}/imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia
        ixx="1e-5" ixy="0.0" ixz="0.0"
        iyy="1e-5" iyz="0.0"
        izz="1e-5"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="${robot_name}/base_link"/>
    <child link="${robot_name}/imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="${robot_name}/imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>

      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><stddev>${ang_vel_noise_sigma}</stddev></noise></x>
          <y><noise type="gaussian"><stddev>${ang_vel_noise_sigma}</stddev></noise></y>
          <z><noise type="gaussian"><stddev>${ang_vel_noise_sigma}</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><stddev>${lin_acc_noise_sigma}</stddev></noise></x>
          <y><noise type="gaussian"><stddev>${lin_acc_noise_sigma}</stddev></noise></y>
          <z><noise type="gaussian"><stddev>${lin_acc_noise_sigma}</stddev></noise></z>
        </linear_acceleration>
      </imu>

      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/trip</namespace>
          <remapping>~/out:=imu</remapping>
        </ros>
        <frame_name>${robot_name}/imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- gazebo_ros_p3d is a MODEL plugin, not a link/sensor plugin —
       it must live in a top-level <gazebo> block with NO reference attribute -->
  <gazebo>
    <plugin name="gazebo_ros_p3d" filename="libgazebo_ros_p3d.so">
      <ros>
        <namespace>/trip</namespace>
        <remapping>odom:=groundtruth</remapping>
      </ros>
      <body_name>trip/base_link</body_name>
      <frame_name>world</frame_name>
      <update_rate>100</update_rate>
      <xyz_offset>0 0 0</xyz_offset>
      <rpy_offset>0 0 0</rpy_offset>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

</robot>