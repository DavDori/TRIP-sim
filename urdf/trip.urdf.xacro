<?xml version="1.0"?>
<robot name="trip" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="trip" />

  <!-- Define the macro for the whole robot -->
  <xacro:macro name="trip" params='robot_name'>

      <xacro:include filename='components/constants.xacro' />
      <xacro:include filename='components/chassis.xacro' />
      <xacro:include filename='components/lidar_scanner.xacro' />
      <xacro:include filename='components/camera.xacro' />
      <xacro:include filename='components/imu.xacro' />
      <xacro:include filename='components/wheels.xacro' />
      <xacro:include filename='components/trip.ros2_control.xacro' />
  </xacro:macro>

  <!-- Instantiate the model -->
  <xacro:trip robot_name="$(arg robot_name)" />

</robot>
